{
  "name": "@sourcegraph/scip-typescript",
  "version": "0.4.0",
  "description": "SCIP indexer for TypeScript and JavaScript",
  "publisher": "sourcegraph",
  "bin": "dist/src/main.js",
  "main": "./dist/src/main.js",
  "scripts": {
    "prettier": "prettier --write --list-different '**/*.{ts,mjs,cjs,js?(on),md,yml}'",
    "prettier-check": "prettier --check '**/*.{ts,mjs,cjs,js?(on),md,yml}'",
    "tslint": "tslint -p tsconfig.json --format stylish",
    "eslint": "eslint --cache '**/*.ts?(x)'",
    "build": "node ./node_modules/typescript/bin/tsc -b .",
    "test": "uvu -r tsx --ignore dist --ignore .direnv",
    "update-snapshots": "uvu -r tsx --ignore dist --ignore .direnv --update-snapshots",
    "prepare": "cd snapshots && yarn && cd input/multi-project && yarn && cd ../pnpm-workspaces && pnpm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourcegraph/scip-typescript.git"
  },
  "keywords": [
    "scip",
    "typescript",
    "compiler",
    "javascript",
    "indexer"
  ],
  "author": "Code Intelligence at Sourcegraph",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/sourcegraph/scip-typescript/issues"
  },
  "homepage": "https://github.com/sourcegraph/scip-typescript#readme",
  "dependencies": {
    "commander": "^14.0.3",
    "google-protobuf": "^3.21.4",
    "progress": "^2.0.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/diff": "7.0.1",
    "@types/google-protobuf": "3.15.12",
    "@types/node": "20.16.10",
    "@types/progress": "2.0.7",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "diff": "7.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ban": "^2.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "pnpm": "9.11.0",
    "prettier": "3.8.3",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.59.4",
    "uvu": "^0.5.6"
  }
}
